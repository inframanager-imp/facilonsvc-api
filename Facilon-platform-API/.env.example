# Azure B2C Configuration for B2C Classic
# Get these values from Azure Portal > Azure AD B2C > App registrations > Your App

# Your B2C tenant name (e.g., facilonservices)
AZURE_B2C_TENANT=facilonservices

# IMPORTANT: DO NOT SET TENANT_ID FOR B2C CLASSIC!
# Leave this commented out or empty. Only use for CIAM/Entra External ID.
# AZURE_B2C_TENANT_ID=

# Application (client) ID from your B2C app registration
AZURE_B2C_CLIENT_ID=54e55d9e-551a-4db4-b1e1-92fdb3e38c01

# Client secret from your B2C app registration
# IMPORTANT: Get this from Azure Portal > Your App > Certificates & secrets
AZURE_B2C_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE

# User flow/policy names (required for B2C Classic)
AZURE_B2C_SIGNIN_POLICY=B2C_1_2Signin
AZURE_B2C_LOGOUT_POLICY=B2C_1_2Signin

# Redirect URI - where Azure B2C sends users after login (must add this exact URL in Azure Portal)
AZURE_B2C_REDIRECT_URI=http://localhost:3000/login/callback
AZURE_B2C_POST_LOGOUT_URI=http://localhost:3000

# OAuth2 scopes to request
AZURE_B2C_SCOPE=openid profile email offline_access
